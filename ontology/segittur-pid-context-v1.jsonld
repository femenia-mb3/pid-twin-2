{
  "@context": {
    "@version": 1.1,
    "id": "@id",
    "type": "@type",
    "ngsi-ld": "https://uri.etsi.org/ngsi-ld/",
    "estur": "https://ontologia.segittur.es/turismo/def/core#",
    "pid": "urn:pid:gemelo:ontology:",
    "dcterms": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "schema": "https://schema.org/",
    "geojson": "https://purl.org/geojson/vocab#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "TouristDestination": "estur:TouristDestination",
    "TourismResource": "estur:TouristEntity",
    "TourismEvent": "estur:Event",
    "Location": "estur:Location",
    "TourismZone": "pid:TourismZone",
    "TourismSensor": "pid:TourismSensor",
    "SimulationScenario": "pid:SimulationScenario",
    "SimulationResult": "pid:SimulationResult",
    "Dataset3D": "pid:Dataset3D",
    "DataSource": "pid:DataSource",
    "DestinationProfile": "pid:DestinationProfile",
    "ContextPackage": "pid:ContextPackage",
    "IngestionContract": "pid:IngestionContract",

    "Property": "ngsi-ld:Property",
    "Relationship": "ngsi-ld:Relationship",
    "GeoProperty": "ngsi-ld:GeoProperty",
    "LanguageProperty": "ngsi-ld:LanguageProperty",
    "ListProperty": "ngsi-ld:ListProperty",
    "ListRelationship": "ngsi-ld:ListRelationship",
    "value": "ngsi-ld:hasValue",
    "object": { "@id": "ngsi-ld:hasObject", "@type": "@id" },
    "observedAt": { "@id": "ngsi-ld:observedAt", "@type": "xsd:dateTime" },
    "createdAt": { "@id": "ngsi-ld:createdAt", "@type": "xsd:dateTime" },
    "modifiedAt": { "@id": "ngsi-ld:modifiedAt", "@type": "xsd:dateTime" },
    "datasetId": "ngsi-ld:datasetId",
    "unitCode": "ngsi-ld:unitCode",

    "destination": { "@id": "pid:destination", "@type": "@id" },
    "tenant": { "@id": "pid:tenant", "@type": "@id" },
    "locatedIn": { "@id": "estur:locatedIn", "@type": "@id" },
    "hasResource": { "@id": "pid:hasResource", "@type": "@id" },
    "hasZone": { "@id": "pid:hasZone", "@type": "@id" },
    "hasDataset": { "@id": "pid:hasDataset", "@type": "@id" },
    "hasContextPackage": { "@id": "pid:hasContextPackage", "@type": "@id" },
    "hasScenario": { "@id": "pid:hasScenario", "@type": "@id" },
    "hasSource": { "@id": "prov:wasDerivedFrom", "@type": "@id" },

    "name": "schema:name",
    "description": "schema:description",
    "location": { "@id": "ngsi-ld:location", "@type": "@id" },
    "geometry": "geojson:geometry",
    "category": "pid:category",
    "capacity": "estur:capacity",
    "capacityLoad": "pid:capacityLoad",
    "currentFlow": "pid:currentFlow",
    "visitorCount": "pid:visitorCount",
    "openingHours": "estur:hasOpeningHours",
    "accessibility": "pid:accessibility",
    "alertLevel": "pid:alertLevel",
    "sensorType": "pid:sensorType",
    "measurement": "pid:measurement",
    "scenarioType": "pid:scenarioType",
    "scenarioParameters": "pid:scenarioParameters",
    "impact": "pid:impact",
    "routeRecommendation": "pid:routeRecommendation",
    "ontologyProfile": "pid:ontologyProfile",
    "namespace": "pid:namespace",
    "timezone": "pid:timezone",
    "spatialLevel": "pid:spatialLevel",
    "coverage": "dcterms:spatial",
    "dataQuality": "pid:dataQuality",
    "updateFrequency": "pid:updateFrequency",
    "traceabilityId": "pid:traceabilityId",
    "license": "dcterms:license",
    "sourceSystem": "prov:wasAttributedTo",
    "version": "dcterms:hasVersion",
    "policy": "pid:policy",
    "checksum": "pid:checksum",
    "ineCode": "pid:ineCode",
    "schemaVersion": "pid:schemaVersion",
    "packageStatus": "pid:packageStatus",
    "dataPolicy": "pid:dataPolicy"
  }
}
